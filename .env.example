# Optional repository-local profile: pass --env .env. Never commit real secrets.
# Default runtime location: ~/.config/omls/connections.env (chmod 600).
# Literal values only. No shell expansion or command substitution.
OMLS_STUDIO_MODE=ssh
OMLS_STUDIO_HOST=
OMLS_STUDIO_PORT=22
OMLS_STUDIO_USER=
OMLS_STUDIO_KEY=/home/YOUR_USER/.ssh/omls_ed25519
OMLS_STUDIO_ROOT=
# SMB alternative: ROOT is relative to SHARE; parent folders must exist.
OMLS_STUDIO_SHARE=
OMLS_STUDIO_PASSWORD=
OMLS_STUDIO_DOMAIN=
